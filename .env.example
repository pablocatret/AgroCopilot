# Copy this file to .env and set only the credentials and overrides you need.
# Never commit a populated .env file.

# Local/offline profile
DISABLE_EXTERNALS=1
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE=http://localhost:8000

# LLM provider: openai | openrouter
LLM_PROVIDER=openai
LLM_BASE_URL_OPENAI=https://api.openai.com/v1
LLM_BASE_URL_OPENROUTER=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=AgroCopilot

# Optional per-agent provider overrides
# LLM_PROVIDER_ORGANIZER=openai
# LLM_PROVIDER_WRITER=openrouter
# LLM_PROVIDER_LEGAL=openai
# LLM_PROVIDER_STAC=openrouter
# LLM_PROVIDER_CASE_MANAGER=openai
# LLM_PROVIDER_DOCUMENT_ANALYST=openrouter
# LLM_PROVIDER_SPREADSHEET_ANALYST=openrouter
# LLM_PROVIDER_VISION_OCR=openrouter
# LLM_PROVIDER_FREE=openrouter

# Models
OPENAI_MODEL_BASELINE=gpt-5-nano
OPENAI_MODEL_ORGANIZER=gpt-5-mini
OPENAI_MODEL_WRITER=gpt-5-mini
OPENAI_MODEL_STAC=gpt-5-mini
OPENAI_MODEL_LEGAL_WRITER=gpt-5-mini
OPENAI_MODEL_LEGAL=gpt-5-mini
OPENAI_MODEL_CASE_MANAGER=gpt-5-mini
OPENAI_MODEL_DOCUMENT_ANALYST=gpt-5-nano
OPENAI_MODEL_SPREADSHEET_ANALYST=gpt-5-nano
OPENAI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_VISION_OCR=gpt-4o-mini
OPENAI_MODEL_FREE=gpt-5-mini
OPENAI_MODEL_QUERY_REWRITER=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web search
SEARCH_PROVIDER=serper
SEARCH_API_KEY=
ALLOWED_DOMAINS=europa.eu,globalgap.org,boe.es

# RAG and legal retrieval
VECTOR_BACKEND=sqlite
DATABASE_URL=sqlite:///./data.db
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=legal_chunks
LEGAL_RAG_STRATEGY=hybrid
LEGALIZE_DATA_DIR=./data/legalize
LEGALIZE_DEFAULT_REPOS=es,eu
LEGALIZE_INGEST_PROFILE=agro

# STAC and remote sensing
ENABLE_STAC=true
ENABLE_RS_ANALYST=true
STAC_SEARCH_MODE=direct
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_SEMANTIC_URL=
STAC_MAX_ITEMS=12
STAC_DEFAULT_COLLECTIONS=
STAC_CONCURRENCY_LIMIT=4

# Geocoding
GEOCODER=NOMINATIM
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_EMAIL=
GEOCODER_COUNTRY_BIAS=ES
GEOCODER_VIEWBOX=
GEOCODER_MAPBOX_TOKEN=
GEOCODER_GOOGLE_KEY=

# Attachments, OCR and local persistence
OCR_BACKEND=none
ATTACHMENTS_DIR=./backend/attachments
MEMORY_DIR=./backend/memory
CONVERSATIONS_DB_PATH=./data/conversations.db
MEMORY_REMOTE_SENSING_TTL_DAYS=21

# Runtime, logging and SSE
LOG_LEVEL=INFO
SSE_LOG_MODE=memory
SSE_TRACE=false
AGENT_CONCURRENCY_LIMIT=4
REPLAN_MAX_COST_USD=2.0

# Cost estimates
COST_TRACKING_ENABLED=true
COST_DB_PATH=./data/costs.db
COST_PRICING_MODE=standard
COST_WARN_USD_PER_CONVERSATION=0.25
COST_WARN_USD_PER_DAY=2.0
WEB_SEARCH_COST_USD_PER_1K=0.0
OPENAI_WEB_SEARCH_COST_USD_PER_1K=10.0
